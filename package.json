{
  "name": "kirigami",
  "productName": "Kirigami",
  "version": "1.0.1",
  "description": "Kirigami (切り紙): desktop app to make print-and-cut card proxy PDFs with the Silhouette Card Maker engine, no command line required.",
  "main": "src/main/main.js",
  "private": true,
  "license": "MIT",
  "author": "mtgtoolkit",
  "homepage": "https://github.com/mtgtoolkit/kirigami",
  "repository": {
    "type": "git",
    "url": "https://github.com/mtgtoolkit/kirigami.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "prestart": "node scripts/fetch-engine.mjs --prestart",
    "start": "electron .",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "e2e": "playwright test --config test/e2e/playwright.config.js",
    "e2e:packaged": "node -e \"const r=require('child_process').spawnSync('playwright test --config test/e2e/playwright.config.js',{stdio:'inherit',shell:true,env:{...process.env,SCM_E2E_PACKAGED:'1'}});process.exit(r.status===null?1:r.status)\"",
    "fetch-uv": "node scripts/fetch-uv.mjs",
    "fetch-engine": "node scripts/fetch-engine.mjs",
    "engine:checkout": "node scripts/checkout-engine.mjs",
    "icon": "npm run fetch-uv && build\\uv\\uv.exe run --no-project --no-config --python 3.12 --with numpy --with pillow scripts/make-icon.py",
    "pack": "npm run fetch-uv && npm run fetch-engine && electron-builder --win --dir",
    "dist": "npm run fetch-uv && npm run fetch-engine && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.5.1",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.mtgtoolkit.kirigami",
    "productName": "Kirigami",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "mtgtoolkit",
      "repo": "kirigami",
      "releaseType": "draft"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/python/**"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "build/engine",
        "to": "engine"
      },
      {
        "from": "build/uv",
        "to": "bin",
        "filter": [
          "uv.exe",
          "LICENSE*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kirigami",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
